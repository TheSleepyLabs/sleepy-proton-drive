#!/usr/bin/env bash
# ==============================================================================
# The Sleepy Labs // Sleepy Proton Drive - Sync Engine
# ==============================================================================
# Backs up local folders to Proton Drive with rclone. Supports copy, sync
# (mirror) and bisync (two-way), with locking, notifications, logging and
# systemd user-timer management.
# ==============================================================================

set -euo pipefail

VERSION="1.1.0"
UNIT_NAME="sleepy-proton-sync"

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
DEFAULT_CONFIG="$CONFIG_HOME/proton-sync.conf"
CONFIG_FILE="${PROTON_SYNC_CONFIG:-$DEFAULT_CONFIG}"
SYSTEMD_USER_DIR="$CONFIG_HOME/systemd/user"
LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp}/sleepy-proton-sync-$(id -u).lock"
BISYNC_STATE_DIR="$STATE_HOME/sleepy-proton-drive/bisync"

# ------------------------------------------------------------------------------
# Defaults (the config file overrides these)
# ------------------------------------------------------------------------------
REMOTE_NAME="protondrive"
DEVICE_NAME=""
SYNC_DIRS=("$HOME/Documents")
SYNC_MODE="copy"
NOTIFY=true
LOG_FILE="$HOME/.local/share/proton-sync.log"
LOG_MAX_LINES=5000
RCLONE_FLAGS=(
    "--verbose"
    "--stats-one-line"
    "--stats=30s"
    "--transfers=4"
    "--checkers=8"
    "--tpslimit=10"
    "--skip-links"
    "--exclude" ".git/**"
    "--exclude" "node_modules/**"
    "--exclude" ".venv/**"
    "--exclude" "__pycache__/**"
    "--exclude" ".cache/**"
    "--exclude" "*.tmp"
    "--exclude" "*.crdownload"
    "--exclude" "*.part"
)

usage() {
    cat <<EOF
Sleepy Proton Drive sync engine v${VERSION} (The Sleepy Labs)

Usage:
  sleepy-proton-sync [OPTIONS]

Sync options:
  -c, --config PATH        Use another config file (default: ~/.config/proton-sync.conf)
  -n, --dry-run            Show what would change without touching any files
  -m, --mode MODE          Override the sync mode for this run (copy, sync, bisync)
  -v, --verbose            Extra rclone debug output
      --no-notify          No desktop notifications for this run

Info:
      --status             Show the current configuration and timer state
      --version            Show the version
  -h, --help               Show this help

Background timer (systemd user timer, no root needed):
      --enable-timer [INTERVAL]   Install/update and start the timer (default 30min;
                                  examples: 15min, 30min, 1h, 2h, 1d)
      --disable-timer             Stop and remove the timer
      --timer-status              Print "active <interval>" or "inactive"
EOF
}

# ------------------------------------------------------------------------------
# Command line (parsed before the config is loaded; applied after it)
# ------------------------------------------------------------------------------
DRY_RUN=false
VERBOSE=false
CLI_MODE=""
CLI_NO_NOTIFY=false
ACTION="sync"
TIMER_INTERVAL="30min"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--config)
            [[ $# -ge 2 ]] || { echo "Error: $1 needs a path" >&2; exit 2; }
            CONFIG_FILE="$2"; shift 2 ;;
        --config=*) CONFIG_FILE="${1#*=}"; shift ;;
        -n|--dry-run) DRY_RUN=true; shift ;;
        -m|--mode)
            [[ $# -ge 2 ]] || { echo "Error: $1 needs a mode" >&2; exit 2; }
            CLI_MODE="$2"; shift 2 ;;
        --mode=*) CLI_MODE="${1#*=}"; shift ;;
        -v|--verbose) VERBOSE=true; shift ;;
        --no-notify) CLI_NO_NOTIFY=true; shift ;;
        --sync-now) shift ;;  # accepted for older desktop launchers
        --status) ACTION="status"; shift ;;
        --enable-timer)
            ACTION="enable-timer"; shift
            if [[ $# -gt 0 && "$1" != -* ]]; then TIMER_INTERVAL="$1"; shift; fi ;;
        --enable-timer=*) ACTION="enable-timer"; TIMER_INTERVAL="${1#*=}"; shift ;;
        --disable-timer) ACTION="disable-timer"; shift ;;
        --timer-status) ACTION="timer-status"; shift ;;
        --version) echo "sleepy-proton-sync $VERSION"; exit 0 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Unknown option: $1 (see --help)" >&2; exit 2 ;;
    esac
done

if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

[[ -n "$CLI_MODE" ]] && SYNC_MODE="$CLI_MODE"
[[ "$CLI_NO_NOTIFY" == "true" ]] && NOTIFY=false

# Device name: fall back to the hostname, and never allow "/" in it.
if [[ -z "${DEVICE_NAME// /}" ]]; then
    DEVICE_NAME="$(hostname 2>/dev/null || uname -n)"
fi
DEVICE_NAME="${DEVICE_NAME//\//-}"

# Expand a leading ~ in a path (no eval, so odd characters are safe).
expand_path() {
    local p="$1"
    case "$p" in
        "~") p="$HOME" ;;
        "~/"*) p="$HOME/${p#\~/}" ;;
    esac
    printf '%s' "$p"
}

# ------------------------------------------------------------------------------
# systemd timer management
# ------------------------------------------------------------------------------
have_user_systemd() {
    command -v systemctl &>/dev/null && systemctl --user show-environment &>/dev/null
}

timer_interval_installed() {
    local f="$SYSTEMD_USER_DIR/$UNIT_NAME.timer"
    [[ -f "$f" ]] && sed -n 's/^OnUnitActiveSec=//p' "$f" | head -n1
}

# Remove the old "proton-sync.*" units from v1.0 (only if they are ours).
remove_legacy_units() {
    local u f
    for u in proton-sync.timer proton-sync.service; do
        f="$SYSTEMD_USER_DIR/$u"
        if [[ -L "$f" ]] || { [[ -f "$f" ]] && grep -q "Sleepy Labs" "$f"; }; then
            systemctl --user disable --now "$u" &>/dev/null || true
            rm -f "$f"
        fi
    done
}

enable_timer() {
    local interval="$1"
    if [[ ! "$interval" =~ ^[0-9]+(s|sec|m|min|h|hr|d|day|days|w|week|weeks)$ ]]; then
        echo "Error: '$interval' is not a valid interval (try 15min, 30min, 1h, 2h, 1d)." >&2
        exit 2
    fi
    if ! have_user_systemd; then
        echo "Error: no systemd user session found, so the background timer can't be used." >&2
        echo "You can still sync by hand (sleepy-proton-sync) or from cron." >&2
        exit 1
    fi
    local self exec_line
    self="$(readlink -f "${BASH_SOURCE[0]}")"
    exec_line="\"$self\""
    if [[ "$(readlink -f "$CONFIG_FILE" 2>/dev/null || echo "$CONFIG_FILE")" != "$(readlink -f "$DEFAULT_CONFIG" 2>/dev/null || echo "$DEFAULT_CONFIG")" ]]; then
        exec_line+=" --config \"$(readlink -f "$CONFIG_FILE")\""
    fi

    mkdir -p "$SYSTEMD_USER_DIR"
    remove_legacy_units
    # Replace (never write through) any symlink left by older versions.
    rm -f "$SYSTEMD_USER_DIR/$UNIT_NAME.service" "$SYSTEMD_USER_DIR/$UNIT_NAME.timer"

    cat > "$SYSTEMD_USER_DIR/$UNIT_NAME.service" <<EOF
[Unit]
Description=The Sleepy Labs - Proton Drive Sync Engine
Documentation=https://github.com/DeathTheLoner/sleepy-proton-drive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=$exec_line
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle
EOF

    cat > "$SYSTEMD_USER_DIR/$UNIT_NAME.timer" <<EOF
[Unit]
Description=The Sleepy Labs - Periodic Proton Drive Sync (every $interval)
Documentation=https://github.com/DeathTheLoner/sleepy-proton-drive

[Timer]
OnBootSec=5min
OnUnitActiveSec=$interval
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
EOF

    systemctl --user daemon-reload
    systemctl --user enable "$UNIT_NAME.timer" &>/dev/null
    systemctl --user restart "$UNIT_NAME.timer"
    echo "Background sync enabled: every $interval ($UNIT_NAME.timer)."
}

disable_timer() {
    if have_user_systemd; then
        systemctl --user disable --now "$UNIT_NAME.timer" &>/dev/null || true
        remove_legacy_units
    fi
    rm -f "$SYSTEMD_USER_DIR/$UNIT_NAME.timer" "$SYSTEMD_USER_DIR/$UNIT_NAME.service"
    have_user_systemd && systemctl --user daemon-reload || true
    echo "Background sync disabled."
}

timer_status() {
    if have_user_systemd && systemctl --user is-active --quiet "$UNIT_NAME.timer"; then
        echo "active $(timer_interval_installed)"
    else
        echo "inactive"
    fi
}

case "$ACTION" in
    enable-timer) enable_timer "$TIMER_INTERVAL"; exit 0 ;;
    disable-timer) disable_timer; exit 0 ;;
    timer-status) timer_status; exit 0 ;;
    status)
        echo "Sleepy Proton Drive v$VERSION"
        echo "  Config: $CONFIG_FILE$([[ -f "$CONFIG_FILE" ]] || echo ' (not created yet - run sleepy-proton-wizard)')"
        echo "  Remote: ${REMOTE_NAME}:"
        echo "  Device: $DEVICE_NAME  (files go to ${REMOTE_NAME}:Devices/${DEVICE_NAME}/<folder>)"
        echo "  Mode:   $SYNC_MODE"
        echo "  Folders:"
        for d in "${SYNC_DIRS[@]}"; do echo "    - $(expand_path "$d")"; done
        echo "  Log:    $LOG_FILE"
        echo "  Timer:  $(timer_status)"
        exit 0 ;;
esac

# ------------------------------------------------------------------------------
# Sync run
# ------------------------------------------------------------------------------
case "$SYNC_MODE" in
    copy|sync|bisync) ;;
    *) echo "Error: SYNC_MODE must be copy, sync or bisync (got '$SYNC_MODE')." >&2; exit 2 ;;
esac

mkdir -p "$(dirname "$LOG_FILE")"

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" | tee -a "$LOG_FILE"
}

send_notification() {
    if [[ "$NOTIFY" == "true" ]] && command -v notify-send &>/dev/null; then
        notify-send -a "Sleepy Proton Drive" -i sleepy-proton-drive -u "${3:-normal}" "$1" "$2" &>/dev/null || true
    fi
}

# Only one sync at a time.
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    EXISTING_PID="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
    if [[ -n "$EXISTING_PID" ]] && kill -0 "$EXISTING_PID" 2>/dev/null; then
        log "Another sync is already running (PID $EXISTING_PID). Skipping this run."
        exit 0
    fi
    rm -rf "$LOCK_DIR"
    mkdir "$LOCK_DIR"
fi
echo "$$" > "$LOCK_DIR/pid"

CHILD_PID=""
cleanup() { rm -rf "$LOCK_DIR"; }
on_signal() {
    if [[ -n "$CHILD_PID" ]]; then
        pkill -TERM -P "$CHILD_PID" 2>/dev/null || true
        kill -TERM "$CHILD_PID" 2>/dev/null || true
    fi
    log "Sync stopped by request."
    exit 143
}
trap cleanup EXIT
trap on_signal INT TERM

# Keep the log from growing forever.
if [[ -f "$LOG_FILE" ]]; then
    line_count="$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)"
    if (( line_count > LOG_MAX_LINES )); then
        tmp_log="$(mktemp "${LOG_FILE}.XXXXXX")"
        tail -n $((LOG_MAX_LINES * 3 / 4)) "$LOG_FILE" > "$tmp_log" && mv "$tmp_log" "$LOG_FILE"
    fi
fi

RUN_LABEL=""
[[ "$DRY_RUN" == "true" ]] && RUN_LABEL=" (DRY RUN - nothing will change)"

log "========================================================================"
log "Sleepy Proton Drive v$VERSION - sync started$RUN_LABEL"
log "Remote: ${REMOTE_NAME}: | Device: ${DEVICE_NAME} | Mode: ${SYNC_MODE}"
log "========================================================================"

if ! command -v rclone &>/dev/null; then
    log "ERROR: rclone is not installed (or not in PATH). Run: sleepy-proton-check --fix"
    send_notification "Proton Drive sync failed" "rclone is not installed." critical
    exit 1
fi

if ! grep -qxF "${REMOTE_NAME}:" <<< "$(rclone listremotes 2>/dev/null)"; then
    log "ERROR: rclone has no remote called '${REMOTE_NAME}'. Run the setup wizard: sleepy-proton-wizard"
    send_notification "Proton Drive sync failed" "Not logged in yet. Run the setup wizard." critical
    exit 1
fi

if [[ ${#SYNC_DIRS[@]} -eq 0 ]]; then
    log "Nothing to do: no folders are selected (SYNC_DIRS is empty)."
    exit 0
fi

FLAGS=("${RCLONE_FLAGS[@]}")
[[ "$VERBOSE" == "true" ]] && FLAGS+=("-vv")
[[ "$DRY_RUN" == "true" ]] && FLAGS+=("--dry-run")

# Run rclone in the background so Stop/Ctrl+C can end it right away.
run_rclone() {
    ( rclone "$@" 2>&1 | tee -a "$LOG_FILE"; exit "${PIPESTATUS[0]}" ) &
    CHILD_PID=$!
    local rc=0
    wait "$CHILD_PID" || rc=$?
    CHILD_PID=""
    return "$rc"
}

TOTAL_OK=0
TOTAL_FAILED=0
TOTAL_SKIPPED=0
SEEN_NAMES=" "

for raw_dir in "${SYNC_DIRS[@]}"; do
    src_dir="$(expand_path "$raw_dir")"
    src_dir="${src_dir%/}"

    if [[ ! -d "$src_dir" ]]; then
        log "WARNING: Skipping '$src_dir' (folder not found)."
        TOTAL_SKIPPED=$((TOTAL_SKIPPED + 1))
        continue
    fi

    name="$(basename "$src_dir")"
    if [[ "$SEEN_NAMES" == *" /$name/ "* ]]; then
        log "WARNING: Skipping '$src_dir': another folder called '$name' is already synced, and both would land in the same cloud folder. Rename one of them."
        TOTAL_SKIPPED=$((TOTAL_SKIPPED + 1))
        continue
    fi
    SEEN_NAMES+="/$name/ "

    dest="${REMOTE_NAME}:Devices/${DEVICE_NAME}/${name}"

    # Safety net: an empty source (e.g. an unmounted drive) would wipe the
    # cloud copy in mirror/two-way mode.
    if [[ "$SYNC_MODE" != "copy" ]] && [[ -z "$(ls -A "$src_dir" 2>/dev/null)" ]]; then
        log "WARNING: Skipping '$src_dir': it is empty, and syncing it in '$SYNC_MODE' mode could delete the cloud copy."
        TOTAL_SKIPPED=$((TOTAL_SKIPPED + 1))
        continue
    fi

    log ">>> '$src_dir' -> '$dest' [$SYNC_MODE]"

    rc=0
    case "$SYNC_MODE" in
        copy) run_rclone copy "$src_dir" "$dest" "${FLAGS[@]}" || rc=$? ;;
        sync) run_rclone sync "$src_dir" "$dest" "${FLAGS[@]}" || rc=$? ;;
        bisync)
            key="$(printf '%s' "${REMOTE_NAME}|${DEVICE_NAME}|${src_dir}" | cksum | cut -d' ' -f1)"
            marker="$BISYNC_STATE_DIR/$key.done"
            extra=()
            if [[ ! -f "$marker" ]]; then
                log "First two-way sync for '$name': running a one-time --resync to set the baseline."
                extra+=("--resync")
            fi
            run_rclone mkdir "$dest" || true
            run_rclone bisync "$src_dir" "$dest" "${extra[@]}" "${FLAGS[@]}" || rc=$?
            if [[ $rc -eq 0 && "$DRY_RUN" != "true" ]]; then
                mkdir -p "$BISYNC_STATE_DIR"
                touch "$marker"
            elif [[ $rc -ne 0 ]]; then
                log "Tip: if rclone says bisync needs a resync, delete '$marker' and run again."
            fi
            ;;
    esac

    if [[ $rc -eq 0 ]]; then
        log "OK: '$name' done."
        TOTAL_OK=$((TOTAL_OK + 1))
    else
        log "FAILED: '$name' (rclone exit code $rc)."
        TOTAL_FAILED=$((TOTAL_FAILED + 1))
    fi
done

log "========================================================================"
if [[ $TOTAL_FAILED -eq 0 ]]; then
    log "SUCCESS: $TOTAL_OK folder(s) synced, $TOTAL_SKIPPED skipped.$RUN_LABEL"
    [[ "$DRY_RUN" == "true" ]] || send_notification "Proton Drive synced" "$TOTAL_OK folder(s) backed up." low
    log "========================================================================"
    exit 0
else
    log "FINISHED WITH ERRORS: $TOTAL_OK ok, $TOTAL_FAILED failed, $TOTAL_SKIPPED skipped. See $LOG_FILE"
    send_notification "Proton Drive sync had errors" "$TOTAL_FAILED folder(s) failed. Open the log for details." normal
    log "========================================================================"
    exit 1
fi
