def have_rclone() -> bool:
    return shutil.which("rclone") is not None


def run_quiet(cmd, timeout=30, **kw):
    """subprocess.run that never raises (missing program, timeout)."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(cmd, 127, "", str(e))


def rclone_remotes():
    if not have_rclone():
        return []
    return [r.strip()[:-1] for r in run_quiet(["rclone", "listremotes"]).stdout.splitlines() if r.strip().endswith(":")]


def timer_status():
    """Returns (active: bool, interval: str)."""
    res = run_quiet([str(SYNC_SCRIPT), "--config", str(CONFIG_PATH), "--timer-status"])
    parts = res.stdout.split()
    if parts and parts[0] == "active":
        return True, (parts[1] if len(parts) > 1 else "")
    return False, ""


def bash_dq(value: str) -> str:
    """Quote a string for a double-quoted Bash word."""
    for a, b in (("\\", "\\\\"), ('"', '\\"'), ("$", "\\$"), ("`", "\\`")):
        value = value.replace(a, b)
    return f'"{value}"'


def bash_path(path: str) -> str:
    """Like bash_dq, but writes paths inside the home folder as "$HOME/..."."""
    home = str(Path.home())
    if path == home:
        return '"$HOME"'
    if path.startswith(home + "/"):
        return '"$HOME' + bash_dq(path[len(home):])[1:]
    return bash_dq(path)


def path_inside(child: str, parent: str) -> bool:
    """True if child is a folder somewhere below parent (as written or with links resolved)."""
    for c, p in ((child, parent), (os.path.realpath(child), os.path.realpath(parent))):
        if c.startswith(p.rstrip("/") + "/"):
            return True
    return False


def short_home(path: str) -> str:
    """Shows /home/<you>/x as ~/x."""
    home = str(Path.home())
    return "~" + path[len(home):] if path == home or path.startswith(home + "/") else path


ANSI_RE = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")

