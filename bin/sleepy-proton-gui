        layout = QVBoxLayout(page_widget)
        layout.setContentsMargins(8, 8, 8, 8)
        layout.setSpacing(14)

        lbl_desc = QLabel(
            "Log in to Proton Drive. Your login is handed to rclone on this computer and saved in\n"
            "~/.config/rclone/rclone.conf. Sleepy Proton Drive never sends it anywhere else."
