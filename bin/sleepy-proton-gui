#!/usr/bin/env python3
"""Sleepy Proton Drive (The Sleepy Labs): runs `python -m sleepy_proton gui`.
The app itself lives in the sleepy_proton folder (next to bin/ in the source, or in
~/.local/share/sleepy-proton-drive/app once installed)."""
import os
import sys
from pathlib import Path

here = Path(os.path.abspath(__file__)).parent
data = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share")
for base in (Path(__file__).resolve().parent.parent, data / "sleepy-proton-drive" / "app"):
    if (base / "sleepy_proton" / "__init__.py").is_file():
        sys.path.insert(0, str(base))
        break
else:
    sys.exit("Sleepy Proton Drive's program files are missing. Run ./install.sh again.")
# So the background timer and Restart call this command, like v1.x did.
os.environ.setdefault("SLEEPY_PROTON_SYNC_BIN", str(here / "sleepy-proton-sync"))

from sleepy_proton.gui import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
