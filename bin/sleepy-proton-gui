        mb_layout.addWidget(QLabel("Mailbox Password:"))
        self.wizard_mailbox_pass = QLineEdit()
        self.wizard_mailbox_pass.setEchoMode(QLineEdit.Password)
        self.wizard_mailbox_pass.setPlaceholderText("Enter legacy mailbox password")
        mb_layout.addWidget(self.wizard_mailbox_pass)
        self.box_mailbox.hide()
        g_layout.addWidget(self.box_mailbox)

        self.chk_otp_secret = QCheckBox("Save my 2FA secret key so rclone can log in again by itself (optional, less secure)")
        self.chk_otp_secret.toggled.connect(lambda c: self.wizard_otp_secret.setVisible(c))
        g_layout.addWidget(self.chk_otp_secret)
        self.wizard_otp_secret = QLineEdit()
        self.wizard_otp_secret.setEchoMode(QLineEdit.Password)
        self.wizard_otp_secret.setPlaceholderText("Base32 secret key shown when you set up 2FA")
        self.wizard_otp_secret.hide()
        g_layout.addWidget(self.wizard_otp_secret)

        layout.addWidget(grp)

        # Connection Test Action
        h_action = QHBoxLayout()
        self.btn_test_conn = QPushButton("⚡ Log In && Test")
        self.btn_test_conn.setObjectName("btnSecondary")
        self.btn_test_conn.clicked.connect(self.authenticate_rclone)
        self.lbl_auth_status = QLabel("Not logged in yet")
        self.lbl_auth_status.setWordWrap(True)
        self.auth_ok = False
        self.auth_proc = None
        self.lbl_auth_status.setStyleSheet("color: #9d8ec2; font-style: italic;")
        h_action.addWidget(self.btn_test_conn)
        h_action.addWidget(self.lbl_auth_status)
        h_action.addStretch()
        layout.addLayout(h_action, 0)
        layout.addStretch()

        self.stack.addWidget(create_scrollable_container(page_widget))
        QTimer.singleShot(0, self.check_existing_login)

    def set_auth_status(self, text, color, bold=False):
        self.lbl_auth_status.setText(text)
        self.lbl_auth_status.setStyleSheet(f"color: {color};" + (" font-weight: bold;" if bold else " font-style: italic;"))

    def check_existing_login(self):
        if not have_rclone():
            self.set_auth_status("✗ rclone is not installed. Close this and click 🩺 Diagnostics, or run: sleepy-proton-check --fix", "#ec4899", True)
            self.btn_test_conn.setEnabled(False)
            return
        if self.config.remote_name in rclone_remotes():
            self.set_auth_status(f"Checking your existing login ('{self.config.remote_name}')...", "#38bdf8")
            self.run_login_test()

    def toggle_password_visibility(self):
        if self.wizard_pass.echoMode() == QLineEdit.Password:
            self.wizard_pass.setEchoMode(QLineEdit.Normal)
            self.btn_toggle_pass.setText("🔒 Hide")
        else:
            self.wizard_pass.setEchoMode(QLineEdit.Password)
            self.btn_toggle_pass.setText("👁 Show")

    def toggle_mailbox_field(self, checked):
        self.box_mailbox.setVisible(checked)

    def authenticate_rclone(self):
        user = self.wizard_user.text().strip()
        pwd = self.wizard_pass.text()
        totp = self.wizard_2fa.text().replace(" ", "")
        mailbox_pwd = self.wizard_mailbox_pass.text() if self.chk_two_pass.isChecked() else ""
        otp_secret = self.wizard_otp_secret.text().replace(" ", "") if self.chk_otp_secret.isChecked() else ""

        if not have_rclone():
            QMessageBox.critical(self, "rclone missing", "rclone is not installed.\nRun: sleepy-proton-check --fix")
            return
        if not user or not pwd:
            QMessageBox.warning(self, "Missing details", "Please enter your Proton email/username and password.")
            return
        if totp and not totp.isdigit():
            QMessageBox.warning(self, "2FA code", "The 2FA code should be numbers only.")
            return

        def obscure(secret):
            return run_quiet(["rclone", "obscure", "-"], input=secret, timeout=15).stdout.strip()

        # Secrets are obscured first so they never show up in plain text in the process list.
        args = ["config", "create", self.config.remote_name, "protondrive", "--no-obscure",
                "username", user, "password", obscure(pwd)]
        if mailbox_pwd:
            args += ["mailbox_password", obscure(mailbox_pwd)]
        if otp_secret:
            args += ["otp_secret_key", obscure(otp_secret)]
        if totp:
            args += ["2fa", totp]

        self.set_auth_status("⏳ Logging in to Proton (can take up to a minute)...", "#38bdf8")
        self.btn_test_conn.setEnabled(False)
        self.btn_next.setEnabled(False)
        self.auth_proc = QProcess(self)
        self.auth_proc.setProcessChannelMode(QProcess.MergedChannels)
        self.auth_proc.finished.connect(self.on_login_created)
        self.auth_proc.start("rclone", args)
        self.wizard_pass.clear()
        self.wizard_2fa.clear()

    def on_login_created(self, code, _status):
        output = bytes(self.auth_proc.readAll()).decode("utf-8", "ignore")
        if code != 0:
            self.btn_test_conn.setEnabled(True)
            self.btn_next.setEnabled(True)
            self.set_auth_status("✗ Login failed. Check your password / 2FA code and try again.", "#ec4899", True)
            safe = "\n".join(l for l in output.splitlines()[-8:] if not re.search(r"password|otp|token|salted", l, re.I))
            QMessageBox.critical(self, "Login failed", f"rclone couldn't log in:\n\n{safe or 'No details given.'}")
            return
        self.set_auth_status("⏳ Logged in. Testing access to your Drive...", "#38bdf8")
        self.run_login_test()

    def run_login_test(self):
        self.btn_test_conn.setEnabled(False)
        self.test_proc = QProcess(self)
        self.test_proc.setProcessChannelMode(QProcess.MergedChannels)
        self.test_proc.finished.connect(self.on_login_tested)
        self.test_proc.start("rclone", ["lsd", f"{self.config.remote_name}:", "--contimeout", "15s", "--timeout", "60s"])
        QTimer.singleShot(90_000, lambda: self.test_proc.state() != QProcess.NotRunning and self.test_proc.kill())

    def on_login_tested(self, code, _status):
        self.btn_test_conn.setEnabled(True)
        self.btn_next.setEnabled(True)
        if code == 0:
            self.auth_ok = True
            self.set_auth_status(f"✓ Logged in to Proton Drive (remote '{self.config.remote_name}'). Click Next.", "#10b981", True)
        else:
            self.auth_ok = False
            self.set_auth_status("✗ Couldn't open your Drive. Log in again below.", "#ec4899", True)

    def create_page_folders(self):
        page_widget = QWidget()
        layout = QVBoxLayout(page_widget)
        layout.setContentsMargins(8, 8, 8, 8)
        layout.setSpacing(12)

        lbl = QLabel("Select local workstation directories to synchronize with Proton Drive:")
        lbl.setStyleSheet("color: #b794ff; font-weight: bold; font-size: 13px;")
        layout.addWidget(lbl)

        # Standard preset checklist
        grp_presets = QGroupBox("Quick Add Standard Directories")
        p_layout = QGridLayout(grp_presets)
        p_layout.setSpacing(10)

        self.preset_checks = {}
        standard_dirs = [
            ("Documents", str(Path.home() / "Documents")),
            ("Pictures", str(Path.home() / "Pictures")),
            ("Desktop", str(Path.home() / "Desktop")),
            ("Downloads", str(Path.home() / "Downloads")),
            ("Music", str(Path.home() / "Music")),
            ("Videos", str(Path.home() / "Videos")),
        ]

        for idx, (name, path) in enumerate(standard_dirs):
            chk = QCheckBox(f"{name} ({path})")
            chk.setChecked(path in self.config.sync_dirs)
            chk.toggled.connect(self.sync_preset_toggled)
            self.preset_checks[path] = chk
            row, col = divmod(idx, 2)
            p_layout.addWidget(chk, row, col)

        layout.addWidget(grp_presets)

        layout.addWidget(QLabel("Active Synced Folders List:"))
        self.folders_list_wizard = QListWidget()
        self.folders_list_wizard.setMinimumHeight(120)
        for folder in self.config.sync_dirs:
            self.folders_list_wizard.addItem(folder)
        layout.addWidget(self.folders_list_wizard, 1)

        h_btns = QHBoxLayout()
        btn_add = QPushButton("+ Add Custom Folder...")
        btn_add.clicked.connect(self.wizard_add_folder)
        btn_rem = QPushButton("- Remove Selected")
        btn_rem.clicked.connect(self.wizard_rem_folder)
        h_btns.addWidget(btn_add)
        h_btns.addWidget(btn_rem)
        h_btns.addStretch()
        layout.addLayout(h_btns)

        self.stack.addWidget(create_scrollable_container(page_widget))

    def sync_preset_toggled(self):
        current_in_list = [self.folders_list_wizard.item(i).text() for i in range(self.folders_list_wizard.count())]
        for path, chk in self.preset_checks.items():
            if chk.isChecked() and path not in current_in_list:
                self.folders_list_wizard.addItem(path)
            elif not chk.isChecked() and path in current_in_list:
                for i in range(self.folders_list_wizard.count()):
                    if self.folders_list_wizard.item(i).text() == path:
                        self.folders_list_wizard.takeItem(i)
                        break

    def wizard_add_folder(self):
        folder = QFileDialog.getExistingDirectory(self, "Select Folder to Sync", str(Path.home()))
        if folder:
            folder = folder.rstrip("/") or "/"
            existing = [self.folders_list_wizard.item(i).text() for i in range(self.folders_list_wizard.count())]
            clash = [d for d in existing if Path(d).name == Path(folder).name and d != folder]
            if clash:
                QMessageBox.warning(self, "Same folder name",
                                    f"'{clash[0]}' has the same name, and both would go to the same cloud folder.")
                return
            if folder not in existing:
                self.folders_list_wizard.addItem(folder)
                if folder in self.preset_checks:
                    self.preset_checks[folder].setChecked(True)

    def wizard_rem_folder(self):
        row = self.folders_list_wizard.currentRow()
        if row >= 0:
            item = self.folders_list_wizard.takeItem(row)
            if item.text() in self.preset_checks:
                self.preset_checks[item.text()].setChecked(False)

    def create_page_sync_settings(self):
        page_widget = QWidget()
        layout = QVBoxLayout(page_widget)
        layout.setContentsMargins(8, 8, 8, 8)
        layout.setSpacing(14)

        grp_device = QGroupBox("Device Identification on Proton Drive")
        d_layout = QVBoxLayout(grp_device)
        d_layout.addWidget(QLabel("Device Name (Cloud destination path: protondrive:Devices/<DeviceName>/...):"))
        self.wizard_device = QLineEdit(self.config.device_name)
        self.wizard_device.setPlaceholderText("e.g. Laptop, Desktop, Work-PC")
        d_layout.addWidget(self.wizard_device)
        layout.addWidget(grp_device)

        grp_mode = QGroupBox("Synchronization Strategy")
        m_layout = QVBoxLayout(grp_mode)
        m_layout.setSpacing(8)

        self.w_radio_copy = QRadioButton("Copy Mode [SAFEST / Recommended]\nOne-way upload. Local deletions NEVER delete files on Proton Drive.")
        self.w_radio_sync = QRadioButton("Sync Mode [Exact Mirror]\nExact mirror. Files deleted locally WILL be removed on Proton Drive.")
        self.w_radio_bisync = QRadioButton("BiSync Mode [Two-Way]\nFull bidirectional sync between local workstation and Proton Drive.")

        if self.config.sync_mode == "sync":
            self.w_radio_sync.setChecked(True)
        elif self.config.sync_mode == "bisync":
            self.w_radio_bisync.setChecked(True)
        else:
            self.w_radio_copy.setChecked(True)

        m_layout.addWidget(self.w_radio_copy)
        m_layout.addWidget(self.w_radio_sync)
        m_layout.addWidget(self.w_radio_bisync)
        layout.addWidget(grp_mode)

        grp_perf = QGroupBox("Transfer Concurrency")
        p_layout = QGridLayout(grp_perf)
        p_layout.setSpacing(10)

        p_layout.addWidget(QLabel("Parallel Transfers:"), 0, 0)
        self.w_spin_trans = QSpinBox()
        self.w_spin_trans.setRange(1, 16)
        self.w_spin_trans.setValue(self.config.transfers)
        p_layout.addWidget(self.w_spin_trans, 0, 1)

        p_layout.addWidget(QLabel("Checker Threads:"), 0, 2)
        self.w_spin_check = QSpinBox()
        self.w_spin_check.setRange(1, 32)
        self.w_spin_check.setValue(self.config.checkers)
        p_layout.addWidget(self.w_spin_check, 0, 3)

        layout.addWidget(grp_perf)
        layout.addStretch()

        self.stack.addWidget(create_scrollable_container(page_widget))

    def create_page_automation(self):
        page_widget = QWidget()
        layout = QVBoxLayout(page_widget)
        layout.setContentsMargins(8, 8, 8, 8)
        layout.setSpacing(14)

        grp_auto = QGroupBox("Background Automation (systemd user timer)")
        a_layout = QVBoxLayout(grp_auto)
        a_layout.setSpacing(12)

        active, current_interval = timer_status()
        self.w_chk_timer = QCheckBox("Sync automatically in the background")
        self.w_chk_timer.setChecked(active or not CONFIG_PATH.exists())
        a_layout.addWidget(self.w_chk_timer)

        h_int = QHBoxLayout()
        h_int.addWidget(QLabel("Scheduled Interval:"))
        self.w_combo_interval = QComboBox()
        self.w_combo_interval.addItems(TIMER_INTERVALS)
        self.w_combo_interval.setCurrentText(current_interval if current_interval in TIMER_INTERVALS else "30min")
        h_int.addWidget(self.w_combo_interval)
        h_int.addStretch()
        a_layout.addLayout(h_int)

        self.w_chk_notify = QCheckBox("Show a desktop notification when a sync finishes")
        self.w_chk_notify.setChecked(self.config.notify)
        a_layout.addWidget(self.w_chk_notify)
        layout.addWidget(grp_auto)

        card_finish = QFrame()
        card_finish.setObjectName("cardSuccess")
        cf_layout = QVBoxLayout(card_finish)
        cf_layout.setContentsMargins(14, 12, 14, 12)
        lbl_ready = QLabel("★ All settings ready to deploy!")
        lbl_ready.setStyleSheet("color: #10b981; font-weight: 800; font-size: 14px;")
        lbl_sub = QLabel(
            "Click 'Complete Setup' to save your settings and (if ticked) turn on background syncing. "
            "Tip: use 🔍 Dry-Run Preview first to see what will be uploaded."
        )
        lbl_sub.setStyleSheet("color: #d1c7eb; font-size: 12px; line-height: 1.4;")
        lbl_sub.setWordWrap(True)
        cf_layout.addWidget(lbl_ready)
        cf_layout.addWidget(lbl_sub)
        layout.addWidget(card_finish)

        layout.addStretch()
        self.stack.addWidget(create_scrollable_container(page_widget))

    def next_page(self):
        idx = self.stack.currentIndex()
        if idx == 0 and not self.auth_ok:
            reply = QMessageBox.question(
                self, "Not logged in",
                "You haven't logged in to Proton Drive yet, so syncing won't work.\n\nContinue anyway?",
                QMessageBox.Yes | QMessageBox.No, QMessageBox.No)
            if reply != QMessageBox.Yes:
                return
        if idx == self.stack.count() - 1:
            self.finish_wizard()
        else:
            self.stack.setCurrentIndex(idx + 1)
            self.update_nav()

    def prev_page(self):
        idx = self.stack.currentIndex()
        if idx > 0:
            self.stack.setCurrentIndex(idx - 1)
            self.update_nav()

    def update_nav(self):
        idx = self.stack.currentIndex()
        count = self.stack.count()
        self.step_label.setText(f"Step {idx + 1} of {count}")
        self.btn_back.setEnabled(idx > 0)

        step_descriptions = [
            "Step 1: Authenticate and securely bind your Proton Drive account",
            "Step 2: Choose directories to mirror into Proton Drive",
            "Step 3: Configure sync strategy, device naming, and concurrency",
            "Step 4: Enable automated background timers and notifications"
        ]
        if idx < len(step_descriptions):
            self.h_desc.setText(step_descriptions[idx])

        if idx == count - 1:
            self.btn_next.setText("Complete Setup ★")
        else:
            self.btn_next.setText("Next Step →")

    def finish_wizard(self):
        dirs = [self.folders_list_wizard.item(i).text() for i in range(self.folders_list_wizard.count())]
        self.config.sync_dirs = dirs
        self.config.device_name = self.wizard_device.text().strip().replace("/", "-") or os.uname().nodename

        if self.w_radio_sync.isChecked():
            self.config.sync_mode = "sync"
        elif self.w_radio_bisync.isChecked():
            self.config.sync_mode = "bisync"
        else:
            self.config.sync_mode = "copy"

        self.config.transfers = self.w_spin_trans.value()
        self.config.checkers = self.w_spin_check.value()
        self.config.notify = self.w_chk_notify.isChecked()
        try:
            self.config.save()
        except (OSError, RuntimeError) as e:
            QMessageBox.critical(self, "Couldn't save", f"Your settings couldn't be saved:\n{e}")
            return

        ok, msg = set_timer(self.w_chk_timer.isChecked(), self.w_combo_interval.currentText())
        if not ok:
            QMessageBox.warning(self, "Background sync", f"Settings saved, but the background timer couldn't be set:\n{msg}")
        self.accept()


def set_timer(enabled: bool, interval: str = "30min"):
    """Turns the systemd user timer on/off through the sync engine. Returns (ok, message)."""
    if enabled:
        cmd = [str(SYNC_SCRIPT), "--config", str(CONFIG_PATH), "--enable-timer", interval]
    else:
        cmd = [str(SYNC_SCRIPT), "--config", str(CONFIG_PATH), "--disable-timer"]
    res = run_quiet(cmd, timeout=30)
    return res.returncode == 0, (res.stdout + res.stderr).strip()


class MainWindow(QMainWindow):
    """Primary Application Window for The Sleepy Labs Proton Drive Manager."""
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Sleepy Proton Drive // The Sleepy Labs")

        # Dynamic, adaptive screen geometry
        screen = QApplication.primaryScreen()
        screen_geo = screen.availableGeometry() if screen else None
        target_w = min(1080, int(screen_geo.width() * 0.75)) if screen_geo else 960
        target_h = min(760, int(screen_geo.height() * 0.82)) if screen_geo else 680
        self.resize(max(target_w, 900), max(target_h, 600))
        self.setMinimumSize(900, 600)
        self.setStyleSheet(SLEEPY_STYLESHEET)

        # Set Window Icon
        icon = next((p for p in ICON_CANDIDATES if p.exists()), None)
        self.setWindowIcon(QIcon(str(icon)) if icon else QIcon.fromTheme("sleepy-proton-drive"))

        self.config = ConfigManager(CONFIG_PATH)
        self.process = None
        self.diag_proc = None
        self._log_mtime = None

        # Build Main UI
        central_widget = QWidget()
        self.setCentralWidget(central_widget)
        self.main_layout = QVBoxLayout(central_widget)
        self.main_layout.setContentsMargins(14, 12, 14, 8)
        self.main_layout.setSpacing(10)

        self.build_header()
        self.build_tabs()
        self.update_timer_status()

        self.status_bar = QStatusBar()
        self.setStatusBar(self.status_bar)
        self.status_bar.showMessage(f"Sleepy Proton Drive v{APP_VERSION} ready.", 4000)

        # Background log checker
        self.log_timer = QTimer(self)
        self.log_timer.setInterval(3000)
        self.log_timer.timeout.connect(self.auto_refresh_log)
        self.log_timer.timeout.connect(self.refresh_running_state)
        self.log_timer.start()
        self._ctl_proc = None
        QTimer.singleShot(200, self.refresh_running_state)

        # First start: offer the wizard (or open it straight away with --wizard)
        if "--wizard" in sys.argv:
            QTimer.singleShot(300, self.open_setup_wizard)
        else:
            QTimer.singleShot(400, self.check_first_run)

    def check_first_run(self):
        if self.config.load_error:
            QMessageBox.warning(self, "Config problem", self.config.load_error)
        if not have_rclone():
            QMessageBox.warning(
                self, "rclone is missing",
                "Sleepy Proton Drive uses rclone to talk to Proton Drive, and it isn't installed.\n\n"
                "Open a terminal and run:\n    sleepy-proton-check --fix\n\n"
                "Then start this app again.")
            return
        if self.config.remote_name not in rclone_remotes():
            reply = QMessageBox.question(
                self, "Welcome to Sleepy Proton Drive",
                "You're not logged in to Proton Drive yet.\n\nOpen the setup wizard now?",
                QMessageBox.Yes | QMessageBox.No
            )
            if reply == QMessageBox.Yes:
                self.open_setup_wizard()

