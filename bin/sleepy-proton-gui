def create_scrollable_container(content_widget: QWidget) -> QScrollArea:
    """Wraps any content widget into a smooth, borderless QScrollArea for adaptive resizing."""
    scroll = QScrollArea()
    scroll.setWidgetResizable(True)
    scroll.setFrameShape(QFrame.NoFrame)
    scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAsNeeded)
    scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
    scroll.setWidget(content_widget)
    return scroll


# Bash snippet that loads the config exactly like the sync engine does and prints
# the values NUL-separated, so the GUI never has to guess at Bash syntax.
_DUMP_CONFIG = r"""
REMOTE_NAME=protondrive; DEVICE_NAME=""; SYNC_MODE=copy; NOTIFY=true
LOG_FILE="$HOME/.local/share/proton-sync.log"; LOG_MAX_LINES=5000
SYNC_DIRS=(); RCLONE_FLAGS=(); EXCLUDE_DIRS=()
PHOTOS_ENABLED=false; PHOTOS_DIR="$HOME/Pictures/Proton Photos"; PHOTOS_MODE=copy
PHOTOS_CATEGORIES=(); PHOTOS_DATES=()
source "$1" >/dev/null 2>&1 || exit 3
printf '%s\0' "$REMOTE_NAME" "$DEVICE_NAME" "$SYNC_MODE" "$NOTIFY" "$LOG_FILE" "$LOG_MAX_LINES"
printf '%s\0' "${#SYNC_DIRS[@]}" "${SYNC_DIRS[@]}"
printf '%s\0' "${#RCLONE_FLAGS[@]}" "${RCLONE_FLAGS[@]}"
printf '%s\0' "${#EXCLUDE_DIRS[@]}" "${EXCLUDE_DIRS[@]}"
printf '%s\0' "$PHOTOS_ENABLED" "$PHOTOS_DIR" "$PHOTOS_MODE"
printf '%s\0' "${#PHOTOS_CATEGORIES[@]}" "${PHOTOS_CATEGORIES[@]}"
printf '%s\0' "${#PHOTOS_DATES[@]}" "${PHOTOS_DATES[@]}"
"""


class ConfigManager:
    """Loads and saves ~/.config/proton-sync.conf (a small Bash file)."""

    def __init__(self, path: Path):
        self.path = path
        self.load_error = ""
        self.set_defaults()
        self.load()

    def set_defaults(self):
        self.remote_name = "protondrive"
        self.device_name = os.uname().nodename
        self.sync_dirs = [str(Path.home() / "Documents"), str(Path.home() / "Pictures")]
        self.exclude_dirs = []
        self.photos_enabled = False
        self.photos_dir = str(DEFAULT_PHOTOS_DIR)
        self.photos_mode = "copy"
        self.photos_categories = []
        self.photos_dates = []
        self.sync_mode = "copy"
        self.notify = True
        self.log_file = str(DEFAULT_LOG_PATH)
        self.log_max_lines = 5000
        self.transfers = 4
        self.checkers = 8
        self.bwlimit = ""
        self.excludes = list(DEFAULT_EXCLUDES)
        self.other_flags = list(DEFAULT_OTHER_FLAGS)

    @property
    def log_path(self) -> Path:
        return Path(self.log_file)

    def load(self):
        self.load_error = ""
        if not self.path.exists():
            return
        res = run_quiet(["bash", "-c", _DUMP_CONFIG, "_", str(self.path)], timeout=10)
        if res.returncode != 0:
            self.load_error = f"Couldn't read {self.path} (is it valid Bash?). Defaults are shown."
            return
        vals = res.stdout.split("\0")
        try:
            (self.remote_name, device, self.sync_mode, notify, self.log_file, max_lines) = vals[:6]
            idx = 6
            n_dirs = int(vals[idx]); idx += 1
            dirs = vals[idx:idx + n_dirs]; idx += n_dirs
            n_flags = int(vals[idx]); idx += 1
            flags = vals[idx:idx + n_flags]; idx += n_flags
            n_ex = int(vals[idx]); idx += 1
            ex_dirs = vals[idx:idx + n_ex]; idx += n_ex
            ph_enabled, ph_dir, ph_mode = vals[idx:idx + 3]; idx += 3
            n = int(vals[idx]); idx += 1
            ph_cats = vals[idx:idx + n]; idx += n
            n = int(vals[idx]); idx += 1
            ph_dates = vals[idx:idx + n]
        except (ValueError, IndexError):
            self.load_error = f"Couldn't understand {self.path}. Defaults are shown."
            self.set_defaults()
            return

        self.remote_name = self.remote_name or "protondrive"
        self.device_name = device.strip() or os.uname().nodename
        if self.sync_mode not in ("copy", "sync", "bisync"):
            self.sync_mode = "copy"
        self.notify = notify.strip().lower() == "true"
        self.log_file = self.log_file or str(DEFAULT_LOG_PATH)
        try:
            self.log_max_lines = int(max_lines)
        except ValueError:
            self.log_max_lines = 5000
        self.sync_dirs = [os.path.expanduser(d).rstrip("/") or "/" for d in dirs]
        self.exclude_dirs = [os.path.expanduser(d).rstrip("/") for d in ex_dirs if d.strip("/ ")]
        self.photos_enabled = ph_enabled.strip().lower() == "true"
        self.photos_dir = os.path.expanduser(ph_dir).rstrip("/") or str(DEFAULT_PHOTOS_DIR)
        self.photos_mode = ph_mode if ph_mode in ("copy", "sync", "bisync") else "copy"
        self.photos_categories = [c.strip().lower() for c in ph_cats if c.strip()]
        self.photos_dates = [d.strip() for d in ph_dates if d.strip()]

        self.excludes, self.other_flags, self.bwlimit = [], [], ""
        i = 0
        while i < len(flags):
            t = flags[i]
            if t == "--exclude" and i + 1 < len(flags):
                self.excludes.append(flags[i + 1]); i += 2; continue
            if t.startswith("--exclude="):
                self.excludes.append(t.split("=", 1)[1])
            elif t.startswith("--transfers="):
                self.transfers = int(t.split("=", 1)[1]) if t.split("=", 1)[1].isdigit() else self.transfers
            elif t.startswith("--checkers="):
                self.checkers = int(t.split("=", 1)[1]) if t.split("=", 1)[1].isdigit() else self.checkers
            elif t.startswith("--bwlimit="):
                self.bwlimit = t.split("=", 1)[1]
            elif t in ("--include", "--filter", "--filter-from", "--exclude-from", "--include-from") and i + 1 < len(flags):
                self.other_flags += [t, flags[i + 1]]; i += 2; continue
            else:
                self.other_flags.append(t)
            i += 1

    def save(self):
        """Writes the config atomically and keeps a .bak of the previous one."""
        self.path.parent.mkdir(parents=True, exist_ok=True)
        lines = [
            "# ==============================================================================",
            "# The Sleepy Labs // Sleepy Proton Drive configuration",
            "# Written by sleepy-proton-gui. This is a Bash file.",
            "# Options explained: https://github.com/TheSleepyLabs/sleepy-proton-drive#configuration",
            "# ==============================================================================",
            "",
            f"REMOTE_NAME={bash_dq(self.remote_name)}",
            f"DEVICE_NAME={bash_dq(self.device_name.replace('/', '-'))}",
            "",
            "SYNC_DIRS=(",
            *[f"    {bash_path(d)}" for d in self.sync_dirs],
            ")",
            "",
            "# Folders inside the ones above that are never backed up.",
            "# Copies already in Proton Drive are kept.",
            "EXCLUDE_DIRS=(",
            *[f"    {bash_path(d)}" for d in self.exclude_dirs],
            ")",
            "",
            "# copy = safest (never deletes in Proton) | sync = mirror | bisync = two-way",
            f"SYNC_MODE={bash_dq(self.sync_mode)}",
            "",
            "# Proton Photos download (needs Proton's proton-drive tool).",
            "# copy = download only | sync = this folder matches Proton Photos | bisync = two-way",
            f"PHOTOS_ENABLED={'true' if self.photos_enabled else 'false'}",
            f"PHOTOS_DIR={bash_path(self.photos_dir)}",
            f"PHOTOS_MODE={bash_dq(self.photos_mode)}",
            "# Empty = everything. Categories: other favorites screenshots videos live-photos",
            "# motion-photos selfies portraits bursts panoramas raw. Dates: \"2026\" or \"2026-11\".",
            "PHOTOS_CATEGORIES=(" + " ".join(bash_dq(c) for c in self.photos_categories) + ")",
            "PHOTOS_DATES=(" + " ".join(bash_dq(d) for d in self.photos_dates) + ")",
            "",
            f"NOTIFY={'true' if self.notify else 'false'}",
            f"LOG_FILE={bash_path(self.log_file)}",
            f"LOG_MAX_LINES={int(self.log_max_lines)}",
            "",
            "RCLONE_FLAGS=(",
            f'    "--transfers={int(self.transfers)}"',
            f'    "--checkers={int(self.checkers)}"',
        ]
        if self.bwlimit:
            lines.append(f"    {bash_dq('--bwlimit=' + self.bwlimit)}")
        i = 0
        while i < len(self.other_flags):
            f = self.other_flags[i]
            if f.startswith(("--transfers", "--checkers", "--bwlimit")):
                i += 1; continue
            if f in ("--include", "--filter", "--filter-from", "--exclude-from", "--include-from") and i + 1 < len(self.other_flags):
                lines.append(f"    {bash_dq(f)} {bash_dq(self.other_flags[i + 1])}"); i += 2; continue
            lines.append(f"    {bash_dq(f)}"); i += 1
        for exc in self.excludes:
            lines.append(f'    "--exclude" {bash_dq(exc)}')
        lines += [")", ""]

        text = "\n".join(lines)
        check = run_quiet(["bash", "-n"], input=text, timeout=10)
        if check.returncode not in (0, 127):
            raise RuntimeError(f"Refusing to save an invalid config:\n{check.stderr}")
        if self.path.exists():
            try:
                shutil.copy2(self.path, self.path.with_name(self.path.name + ".bak"))
            except OSError:
                pass
        tmp = self.path.with_name(self.path.name + ".tmp")
        tmp.write_text(text, encoding="utf-8")
        os.replace(tmp, self.path)


class SetupWizardDialog(QDialog):
    """Adaptive, scrollable multi-step onboarding wizard for Proton Drive."""
    def __init__(self, parent=None, config=None):
