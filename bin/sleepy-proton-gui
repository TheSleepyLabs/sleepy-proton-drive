    def update_timer_status(self):
        active, interval = timer_status()
        if active:
            self.lbl_stat_timer.setText(f"On (every {interval})" if interval else "On")
            self.lbl_stat_timer.setStyleSheet("color: #10b981; font-weight: 800; font-size: 14px;")
        else:
            self.lbl_stat_timer.setText("Off")
            self.lbl_stat_timer.setStyleSheet("color: #ec4899; font-weight: 800; font-size: 14px;")
        if hasattr(self, "combo_timer_int") and interval in TIMER_INTERVALS:
            self.combo_timer_int.setCurrentText(interval)

